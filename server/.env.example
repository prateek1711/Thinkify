# Server Port
PORT=3000

# Client Application URL (for CORS allowance)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Database Name
DATABASE_NAME=thinkify

# Salt rounds for Bcrypt hashing
BCRYPT_GEN_SALT_NUMBER=10

# Secret key for JWT token signing
JWT_SECRET_KEY=your_jwt_secret_key_here

# Cookie expiration time (e.g. 5d for 5 days)
COOKIE_EXPIRES=5d

# Key name for authentication cookie
COOKIE_KEY=thinkify

# Directory for file uploads
UPLOAD_DIRECTORY=uploads
